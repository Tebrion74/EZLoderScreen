FrameWidgetClass EZMedManualRoot {
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass EZBg {
   ignorepointer 1
   color 0 0 0 0.85
   position 0 0
   size 640 560
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style rover_sim_colorable
   {
    TextWidgetClass EZTitle {
     ignorepointer 1
     position 0 10
     size 640 34
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     text "Terje Field Medical Manual"
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 22
     "text halign" center
     "text valign" center
    }
    TextWidgetClass EZPageTitle {
     ignorepointer 1
     position 20 50
     size 600 28
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 1 0.85 0.4 1
     text "Section"
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 18
     "text halign" left
     "text valign" center
    }
    MultilineTextWidgetClass EZPageBody {
     ignorepointer 1
     position 20 84
     size 600 400
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     text ""
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 15
     wrap 1
    }
    ButtonWidgetClass EZBtn_Prev {
     position 20 512
     size 150 32
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 0.2 0.6 1 0.35
     text "< Prev"
     font "gui/fonts/sdf_MetronBook24"
     "text size" 16
    }
    TextWidgetClass EZPageNum {
     ignorepointer 1
     position 180 512
     size 120 32
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     text "1 / 1"
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 16
     "text halign" center
     "text valign" center
    }
    ButtonWidgetClass EZBtn_Next {
     position 310 512
     size 150 32
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 0.2 0.6 1 0.35
     text "Next >"
     font "gui/fonts/sdf_MetronBook24"
     "text size" 16
    }
    ButtonWidgetClass EZBtn_Close {
     position 470 512
     size 150 32
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 1 0.3 0.3 0.35
     text "Close"
     font "gui/fonts/sdf_MetronBook24"
     "text size" 16
    }
   }
  }
 }
}
